generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WebsiteReview {
  reviewer String
  pagePath String
  comment String @default("")
  status String @default("NOT_REVIEWED")
  updatedAt DateTime @updatedAt

  @@id([reviewer, pagePath])
}

enum SupplierConnectionType {
  API
  CSV
  XLSX
  MANUAL
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum SupplierSyncResource {
  PRODUCTS
  STOCK
  PRICES
}

enum SupplierSyncStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

enum SupplierImageKind {
  HERO
  COLOUR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuoteStatus {
  SUBMITTED
  REVIEWING
  QUOTED
  APPROVED
  DECLINED
  IN_PRODUCTION
  READY
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
  TO_BE_CONFIRMED
}

enum DecorationLocation {
  FRONT_LEFT_CHEST
  FRONT_RIGHT_CHEST
  FRONT_CENTRE
  FRONT_FULL
  BACK_UPPER
  BACK_FULL
  LEFT_SLEEVE
  RIGHT_SLEEVE
}

enum DecorationMethod {
  SCREEN_PRINT
  EMBROIDERY
  DTF
}

enum QuoteEventType {
  QUOTE_SUBMITTED
  STAFF_NOTIFICATION_SENT
  STAFF_NOTIFICATION_FAILED
  CUSTOMER_CONFIRMATION_SENT
  CUSTOMER_CONFIRMATION_FAILED
  STATUS_CHANGED
  NOTIFICATION_RESENT
  ARTWORK_UPLOADED
  ARTWORK_APPROVED
  ARTWORK_REJECTED
  ARTWORK_ARCHIVED
  ARTWORK_DOWNLOADED
}

enum ArtworkStatus {
  UPLOADED
  APPROVED
  REJECTED
  ARCHIVED
  DELETED
}

enum ArtworkScanStatus {
  PENDING
  CLEAN
  REJECTED
  NOT_SCANNED
}

enum QuoteWorkflowStage {
  QUOTE_SUBMITTED
  ARTWORK_REVIEW
  PROOF_PREPARATION
  AWAITING_CUSTOMER_APPROVAL
  PRODUCTION_PLANNING
  SUPPLIER_ORDER_PREPARATION
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  READY
  COMPLETED
  CANCELLED
}

enum ArtworkRevisionStatus {
  OPEN
  RESOLVED
  CANCELLED
}
enum ArtworkProofStatus {
  DRAFT
  READY_FOR_CUSTOMER
  APPROVED
  REJECTED
  SUPERSEDED
}
enum ProductionJobStatus {
  PLANNING
  READY
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}
enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum ProductionItemStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}
enum ProductionTaskStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}
enum SupplierRequirementStatus {
  REQUIRED
  READY_TO_ORDER
  ORDERED
  RECEIVED
  CANCELLED
}
enum PurchaseDraftStatus {
  DRAFT
  READY
  SUBMITTED_MANUALLY
  ORDERED
  PART_RECEIVED
  RECEIVED
  CANCELLED
}

enum RateLimitScope {
  LOGIN
  QUOTE_SUBMISSION
  ARTWORK_UPLOAD
  PROOF_ACCESS
  PROOF_ACTION
}

enum NotificationType {
  CUSTOMER_ACKNOWLEDGEMENT
  STAFF_QUOTE_NOTIFICATION
  ARTWORK_REVISION
  PROOF_READY
  IN_PRODUCTION
  READY
}

enum NotificationRecipientType {
  CUSTOMER
  STAFF
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

enum StaffRole {
  ADMIN
  CATALOGUE_MANAGER
  QUOTE_MANAGER
  READ_ONLY
}

enum AdminAuditAction {
  LOGIN
  QUOTE_STATUS_CHANGED
  QUOTE_INTERNAL_NOTE_ADDED
  NOTIFICATION_RESENT
  PRODUCT_UPDATED
  PRODUCT_PUBLISHED
  PRODUCT_UNPUBLISHED
  SUPPLIER_PRODUCT_PUBLISHED
  SUPPLIER_PRODUCT_LINKED
  BRAND_CREATED
  BRAND_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  SUPPLIER_SYNC_QUEUED
  ARTWORK_APPROVED
  ARTWORK_REJECTED
  ARTWORK_ARCHIVED
  ARTWORK_DOWNLOADED
  WORKFLOW_STAGE_CHANGED
  ARTWORK_REVISION_REQUESTED
  ARTWORK_REVISION_RESOLVED
  ARTWORK_PROOF_CREATED
  ARTWORK_PROOF_READY
  ARTWORK_PROOF_APPROVED
  ARTWORK_PROOF_REJECTED
  PRODUCTION_JOB_CREATED
  PRODUCTION_JOB_UPDATED
  SUPPLIER_REQUIREMENTS_CREATED
  PURCHASE_DRAFT_CREATED
  PURCHASE_DRAFT_UPDATED
  SUPPLIER_REQUIREMENT_WAIVED
  PROOF_TOKEN_REVOKED
  PROOF_TOKEN_REGENERATED
  NOTIFICATION_SENT
  PRODUCTION_ASSIGNMENT_CHANGED
  PRODUCTION_PRIORITY_CHANGED
  PRODUCTION_DUE_DATE_CHANGED
  PRODUCTION_TASK_STATUS_CHANGED
  PRODUCTION_STATUS_CHANGED
  PURCHASE_DRAFT_READY
}

enum SupplierSyncType {
  FULL
  PRODUCTS_INCREMENTAL
  STOCK_PRICES_INCREMENTAL
}

enum SupplierSyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum SupplierSyncTriggerType {
  MANUAL
  SCHEDULED
  DEVELOPMENT
}

enum SupplierSyncPhase {
  QUEUED
  FETCHING_PRODUCTS
  PROCESSING_PRODUCTS
  FETCHING_STOCK
  PROCESSING_STOCK
  FETCHING_PRICES
  PROCESSING_PRICES
  FINALIZING
  COMPLETE
}

model Supplier {
  id             String                 @id @default(cuid())
  name           String
  slug           String                 @unique
  connectionType SupplierConnectionType
  status         SupplierStatus         @default(ACTIVE)
  apiBaseUrl     String?
  lastSyncAt     DateTime?
  lastSyncStatus SupplierSyncStatus?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  products       SupplierProduct[]
  variants       SupplierVariant[]
  syncStates     SupplierSyncState[]
  syncRuns       SupplierSyncRun[]
  syncLock       SupplierSyncLock?
  requirements   SupplierRequirement[]
  purchaseDrafts SupplierPurchaseDraft[]
}

model SupplierProduct {
  id                 String            @id @default(cuid())
  supplierId         String
  supplierProductKey String
  style              String?
  supplierTitle      String
  supplierBrand      String
  supplierCategory   String
  fabric             String?
  features           String?
  htmlDescription    String?
  textDescription    String?
  sizeChart          String?
  /// Confidential supplier payload. Server-side troubleshooting only; never expose in public DTOs.
  rawData             Json?
  active              Boolean           @default(true)
  lastSyncedAt        DateTime
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  supplier            Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  colours             SupplierColour[]
  variants            SupplierVariant[]
  images              SupplierImage[]
  catalogueLinks      ProductSupplier[]
  requirements        SupplierRequirement[]

  @@unique([supplierId, supplierProductKey])
  @@index([style])
  @@index([supplierBrand])
  @@index([supplierCategory])
  @@index([active])
  @@index([supplierId, active])
  @@index([supplierId, supplierBrand])
  @@index([supplierId, supplierCategory])
  @@index([lastSyncedAt])
  @@index([supplierId, lastSyncedAt])
}

model SupplierColour {
  id                   String            @id @default(cuid())
  supplierProductId    String
  colourCode           String
  colourDescription    String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  supplierProduct      SupplierProduct   @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  variants             SupplierVariant[]
  images               SupplierImage[]

  @@unique([supplierProductId, colourCode])
}

model SupplierVariant {
  id                   String          @id @default(cuid())
  supplierId           String
  supplierColourId     String
  supplierProductId    String
  sku                  String
  supplierVariantId    String?
  size                 String
  stock                Int             @default(0)
  supplierPrice        Decimal?        @db.Decimal(12, 4)
  priceUpdatedAt       DateTime?
  stockUpdatedAt       DateTime?
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  supplier             Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierColour       SupplierColour  @relation(fields: [supplierColourId], references: [id], onDelete: Cascade)
  supplierProduct      SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  requirements         SupplierRequirement[]

  @@unique([supplierId, sku])
  @@index([supplierProductId])
  @@index([supplierColourId])
  @@index([active])
  @@index([supplierId, active])
  @@index([stockUpdatedAt])
  @@index([priceUpdatedAt])
}

model SupplierImage {
  id                   String            @id @default(cuid())
  supplierProductId    String
  supplierColourId     String?
  url                  String
  kind                 SupplierImageKind
  sortOrder            Int               @default(0)
  createdAt            DateTime          @default(now())
  supplierProduct      SupplierProduct   @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  supplierColour       SupplierColour?   @relation(fields: [supplierColourId], references: [id], onDelete: Cascade)

  @@unique([supplierProductId, url])
  @@index([supplierColourId])
}

model Product {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  brandId        String?
  categoryId     String?
  status         ProductStatus     @default(DRAFT)
  featured       Boolean           @default(false)
  newProduct     Boolean           @default(false)
  screenPrint    Boolean           @default(false)
  embroidery     Boolean           @default(false)
  dtf            Boolean           @default(false)
  primaryImage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  brand          Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierLinks  ProductSupplier[]
  quoteLines     QuoteLine[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
}

model Quote {
  id                  String          @id @default(cuid())
  quoteNumber         String          @unique
  idempotencyKey      String          @unique
  confirmationToken   String          @unique
  status              QuoteStatus     @default(SUBMITTED)
  workflowStage       QuoteWorkflowStage @default(QUOTE_SUBMITTED)
  artworkNoFileConfirmedAt DateTime?
  artworkNoFileConfirmedById String?
  artworkNoFileNote   String?
  supplierRequirementWaivedAt DateTime?
  supplierRequirementWaivedById String?
  supplierRequirementWaiverReason String?
  customerName        String
  businessName        String?
  email               String
  phone               String?
  requiredBy          DateTime?       @db.Date
  deliveryMethod      DeliveryMethod?
  deliveryAddress     String?
  customerNotes       String?
  submittedAt         DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  lines               QuoteLine[]
  events              QuoteEvent[]
  internalNotes       QuoteInternalNote[]
  artworkFiles        ArtworkFile[]
  workflowEvents      QuoteWorkflowEvent[]
  revisionRequests    ArtworkRevisionRequest[]
  artworkProofs       ArtworkProof[]
  productionJob       ProductionJob?
  supplierRequirements SupplierRequirement[]
  purchaseDrafts      SupplierPurchaseDraft[]
  notifications       NotificationDelivery[]
  artworkNoFileConfirmedBy StaffUser? @relation("ArtworkNoFileConfirmedBy", fields: [artworkNoFileConfirmedById], references: [id], onDelete: SetNull)
  supplierRequirementWaivedBy StaffUser? @relation("SupplierRequirementWaivedBy", fields: [supplierRequirementWaivedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([workflowStage])
  @@index([submittedAt])
}

model QuoteLine {
  id                        String            @id @default(cuid())
  quoteId                   String
  productId                 String?
  productNameSnapshot       String
  productSlugSnapshot       String
  brandSnapshot             String?
  categorySnapshot          String?
  colourCode                String
  colourDescription         String
  imageUrl                  String?
  customerNotes             String?
  totalQuantity             Int
  sortOrder                 Int
  createdAt                 DateTime          @default(now())
  quote                     Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product                   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  sizes                     QuoteLineSize[]
  decorations               QuoteDecoration[]
  artworkFiles              ArtworkFile[]
  revisionRequests          ArtworkRevisionRequest[]
  artworkProofs             ArtworkProof[]
  productionItems           ProductionJobItem[]
  supplierRequirements      SupplierRequirement[]

  @@index([quoteId])
  @@index([productId])
}

model QuoteLineSize {
  id          String    @id @default(cuid())
  quoteLineId String
  size        String
  quantity    Int
  createdAt   DateTime  @default(now())
  quoteLine   QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)

  @@unique([quoteLineId, size])
}

model QuoteDecoration {
  id             String             @id @default(cuid())
  quoteLineId    String
  location       DecorationLocation
  locationLabel  String
  method         DecorationMethod
  methodLabel    String
  customerNote   String?
  createdAt      DateTime           @default(now())
  quoteLine      QuoteLine          @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  artworkFiles   ArtworkFile[]
  revisionRequests ArtworkRevisionRequest[]
  artworkProofs ArtworkProof[]
  productionTasks ProductionDecorationTask[]

  @@unique([quoteLineId, location])
}

model TemporaryArtworkUpload {
  id                String       @id @default(cuid())
  clientUploadToken String       @unique
  quoteLineClientId String
  decorationLocation DecorationLocation?
  originalFileName  String
  storageKey        String       @unique
  mimeType          String
  extension         String
  sizeBytes         Int
  sha256            String
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime     @default(now())
  artworkFile       ArtworkFile?

  @@index([expiresAt, consumedAt])
  @@index([quoteLineClientId])
}

model ArtworkFile {
  id                String            @id @default(cuid())
  quoteId           String?
  quoteLineId       String?
  decorationId      String?
  temporaryUploadId String?           @unique
  originalFileName  String
  storageKey        String            @unique
  mimeType          String
  extension         String
  sizeBytes         Int
  sha256            String
  status            ArtworkStatus     @default(UPLOADED)
  scanStatus        ArtworkScanStatus @default(NOT_SCANNED)
  customerLabel     String?
  staffNote         String?
  rejectionReason   String?
  uploadedAt        DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  quote             Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quoteLine         QuoteLine?         @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  decoration        QuoteDecoration?   @relation(fields: [decorationId], references: [id], onDelete: SetNull)
  temporaryUpload   TemporaryArtworkUpload? @relation(fields: [temporaryUploadId], references: [id], onDelete: SetNull)
  proofs             ArtworkProof[]
  productionTasks   ProductionDecorationTask[]

  @@index([quoteId, status])
  @@index([quoteLineId])
  @@index([decorationId])
  @@index([sha256])
}

model QuoteEvent {
  id        String         @id @default(cuid())
  quoteId   String
  eventType QuoteEventType
  message   String?
  previousStatus QuoteStatus?
  newStatus QuoteStatus?
  staffUserId String?
  createdAt DateTime       @default(now())
  quote     Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  staffUser StaffUser?     @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
}

model QuoteInternalNote {
  id          String    @id @default(cuid())
  quoteId     String
  staffUserId String
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@index([quoteId, createdAt])
  @@index([staffUserId])
}

model QuoteNumberCounter {
  year      Int @id
  nextValue Int
}

model QuoteWorkflowEvent {
  id String @id @default(cuid())
  quoteId String
  previousStage QuoteWorkflowStage?
  newStage QuoteWorkflowStage
  staffUserId String?
  note String?
  createdAt DateTime @default(now())
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  @@index([quoteId, createdAt])
}

model ArtworkRevisionRequest {
  id String @id @default(cuid())
  quoteId String
  quoteLineId String?
  decorationId String?
  status ArtworkRevisionStatus @default(OPEN)
  request String
  customerVisible Boolean @default(true)
  requestedById String
  resolvedById String?
  resolvedAt DateTime?
  resolutionNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteLine QuoteLine? @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  decoration QuoteDecoration? @relation(fields: [decorationId], references: [id], onDelete: SetNull)
  requestedBy StaffUser @relation("RevisionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedBy StaffUser? @relation("RevisionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  @@index([quoteId, status])
}

model ArtworkProof {
  id String @id @default(cuid())
  quoteId String
  quoteLineId String
  decorationId String
  sourceArtworkFileId String?
  version Int
  status ArtworkProofStatus @default(DRAFT)
  originalFileName String
  storageKey String @unique
  mimeType String
  extension String
  sizeBytes Int
  sha256 String
  staffNote String?
  customerResponseNote String?
  createdById String
  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteLine QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  decoration QuoteDecoration @relation(fields: [decorationId], references: [id], onDelete: Cascade)
  sourceArtworkFile ArtworkFile? @relation(fields: [sourceArtworkFileId], references: [id], onDelete: SetNull)
  createdBy StaffUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  approvalTokens ProofApprovalToken[]
  productionTasks ProductionDecorationTask[]
  notifications NotificationDelivery[]
  @@unique([decorationId, version])
  @@index([quoteId, status])
}

model ProofApprovalToken {
  id String @id @default(cuid())
  proofId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  proof ArtworkProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  @@index([proofId, expiresAt])
}

model ProductionJob {
  id String @id @default(cuid())
  jobNumber String @unique
  quoteId String @unique
  status ProductionJobStatus @default(PLANNING)
  priority ProductionPriority @default(NORMAL)
  requiredBy DateTime? @db.Date
  internalNote String?
  assignedToStaffUserId String?
  completedAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  createdBy StaffUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assignedToStaffUser StaffUser? @relation("ProductionJobAssignee", fields: [assignedToStaffUserId], references: [id], onDelete: SetNull)
  items ProductionJobItem[]
  history ProductionJobEvent[]
  @@index([status, requiredBy])
}

model ProductionJobItem {
  id String @id @default(cuid())
  productionJobId String
  quoteLineId String
  productNameSnapshot String
  colourSnapshot String
  quantity Int
  status ProductionItemStatus @default(PENDING)
  notes String?
  sortOrder Int
  productionJob ProductionJob @relation(fields: [productionJobId], references: [id], onDelete: Cascade)
  quoteLine QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Restrict)
  tasks ProductionDecorationTask[]
  @@unique([productionJobId, quoteLineId])
}

model ProductionDecorationTask {
  id String @id @default(cuid())
  productionJobItemId String
  decorationId String
  approvedProofId String?
  approvedArtworkFileId String?
  locationSnapshot String
  methodSnapshot String
  status ProductionTaskStatus @default(PENDING)
  note String?
  assignedToStaffUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productionJobItem ProductionJobItem @relation(fields: [productionJobItemId], references: [id], onDelete: Cascade)
  decoration QuoteDecoration @relation(fields: [decorationId], references: [id], onDelete: Restrict)
  approvedProof ArtworkProof? @relation(fields: [approvedProofId], references: [id], onDelete: SetNull)
  approvedArtworkFile ArtworkFile? @relation(fields: [approvedArtworkFileId], references: [id], onDelete: SetNull)
  assignedToStaffUser StaffUser? @relation("ProductionTaskAssignee", fields: [assignedToStaffUserId], references: [id], onDelete: SetNull)
  @@unique([productionJobItemId, decorationId])
}

model SupplierRequirement {
  id String @id @default(cuid())
  quoteId String
  quoteLineId String
  supplierId String?
  supplierVariantId String?
  supplierProductId String?
  size String
  quantity Int
  supplierSkuSnapshot String?
  stockSnapshot Int?
  status SupplierRequirementStatus @default(REQUIRED)
  reviewReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteLine QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierVariant SupplierVariant? @relation(fields: [supplierVariantId], references: [id], onDelete: SetNull)
  supplierProduct SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  purchaseDraftItem SupplierPurchaseDraftItem?
  @@unique([quoteLineId, size])
  @@index([quoteId, status])
}

model SupplierPurchaseDraft {
  id String @id @default(cuid())
  draftNumber String @unique
  quoteId String
  supplierId String
  status PurchaseDraftStatus @default(DRAFT)
  internalNote String?
  staleStockConfirmedAt DateTime?
  staleStockConfirmedById String?
  staleStockConfirmationNote String?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy StaffUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  staleStockConfirmedBy StaffUser? @relation("PurchaseDraftStaleStockConfirmedBy", fields: [staleStockConfirmedById], references: [id], onDelete: SetNull)
  items SupplierPurchaseDraftItem[]
  @@unique([quoteId, supplierId])
  @@index([status])
}

model SupplierPurchaseDraftItem {
  id String @id @default(cuid())
  purchaseDraftId String
  supplierRequirementId String @unique
  skuSnapshot String
  sizeSnapshot String
  quantity Int
  purchaseDraft SupplierPurchaseDraft @relation(fields: [purchaseDraftId], references: [id], onDelete: Cascade)
  supplierRequirement SupplierRequirement @relation(fields: [supplierRequirementId], references: [id], onDelete: Restrict)
}

model ProductionJobNumberCounter {
  year Int @id
  nextValue Int
}

model PurchaseDraftNumberCounter {
  year Int @id
  nextValue Int
}

model RateLimitBucket {
  id String @id @default(cuid())
  keyHash String
  scope RateLimitScope
  windowStart DateTime
  count Int @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([keyHash, scope, windowStart])
  @@index([expiresAt])
}

model NotificationSettings {
  id String @id @default("default")
  sendCustomerAcknowledgement Boolean @default(true)
  sendStaffQuoteNotification Boolean @default(true)
  sendProofReady Boolean @default(true)
  sendArtworkRevision Boolean @default(true)
  sendInProduction Boolean @default(false)
  sendReady Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model NotificationDelivery {
  id String @id @default(cuid())
  quoteId String
  proofId String?
  type NotificationType
  recipientType NotificationRecipientType
  status NotificationDeliveryStatus
  attemptedAt DateTime @default(now())
  sentAt DateTime?
  safeErrorSummary String?
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  proof ArtworkProof? @relation(fields: [proofId], references: [id], onDelete: SetNull)
  @@index([quoteId, attemptedAt])
  @@index([type, status])
}

model ProductionJobEvent {
  id String @id @default(cuid())
  productionJobId String
  staffUserId String
  eventType String
  summary String
  createdAt DateTime @default(now())
  productionJob ProductionJob @relation(fields: [productionJobId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  @@index([productionJobId, createdAt])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  description String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([active])
}

model Category {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  parentId  String?
  active    Boolean     @default(true)
  description String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  parent    Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]  @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@index([active])
}

model StaffUser {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String
  passwordHash  String?
  role          StaffRole          @default(READ_ONLY)
  active        Boolean            @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  quoteEvents   QuoteEvent[]
  internalNotes QuoteInternalNote[]
  auditLogs     AdminAuditLog[]
  triggeredSyncRuns SupplierSyncRun[]
  workflowEvents QuoteWorkflowEvent[]
  artworkNoFileConfirmations Quote[] @relation("ArtworkNoFileConfirmedBy")
  supplierRequirementWaivers Quote[] @relation("SupplierRequirementWaivedBy")
  revisionRequests ArtworkRevisionRequest[] @relation("RevisionRequestedBy")
  resolvedRevisionRequests ArtworkRevisionRequest[] @relation("RevisionResolvedBy")
  artworkProofs ArtworkProof[]
  productionJobs ProductionJob[]
  assignedProductionJobs ProductionJob[] @relation("ProductionJobAssignee")
  assignedProductionTasks ProductionDecorationTask[] @relation("ProductionTaskAssignee")
  purchaseDrafts SupplierPurchaseDraft[]
  staleStockConfirmations SupplierPurchaseDraft[] @relation("PurchaseDraftStaleStockConfirmedBy")
  productionJobEvents ProductionJobEvent[]

  @@index([active])
  @@index([role])
}

model AdminAuditLog {
  id          String           @id @default(cuid())
  staffUserId String
  action      AdminAuditAction
  entityType  String
  entityId    String
  summary     String
  createdAt   DateTime         @default(now())
  staffUser   StaffUser        @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@index([staffUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model ProductSupplier {
  id                  String          @id @default(cuid())
  productId           String
  supplierProductId   String
  preferredSupplier   Boolean         @default(false)
  createdAt           DateTime        @default(now())
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierProduct     SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierProductId])
  @@index([supplierProductId])
}

model SupplierSyncState {
  id                   String               @id @default(cuid())
  supplierId           String
  resource             SupplierSyncResource
  lastSuccessfulCursor String?
  lastAttemptedAt      DateTime?
  status               SupplierSyncStatus   @default(IDLE)
  errorSummary         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  supplier             Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, resource])
  @@index([status])
}

model SupplierSyncRun {
  id                     String                  @id @default(cuid())
  supplierId             String
  syncType               SupplierSyncType
  status                 SupplierSyncRunStatus   @default(QUEUED)
  triggerType            SupplierSyncTriggerType
  triggeredByStaffUserId String?
  phase                  SupplierSyncPhase       @default(QUEUED)
  queuedAt               DateTime                @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  attemptCount           Int                     @default(0)
  productCount           Int                     @default(0)
  productAddedCount      Int                     @default(0)
  productUpdatedCount    Int                     @default(0)
  colourCount            Int                     @default(0)
  variantCount           Int                     @default(0)
  imageCount             Int                     @default(0)
  stockUpdatedCount      Int                     @default(0)
  priceUpdatedCount      Int                     @default(0)
  skippedCount           Int                     @default(0)
  removedProductCount    Int                     @default(0)
  removedVariantCount    Int                     @default(0)
  errorSummary           String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  supplier               Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  triggeredByStaffUser   StaffUser?               @relation(fields: [triggeredByStaffUserId], references: [id], onDelete: SetNull)
  lock                    SupplierSyncLock?

  @@index([supplierId, queuedAt])
  @@index([status, queuedAt])
  @@index([triggeredByStaffUserId])
}

model SupplierSyncLock {
  supplierId String   @id
  syncRunId  String   @unique
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  syncRun    SupplierSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
